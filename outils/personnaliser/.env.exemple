# Variables du .env produit par `npm run client -- <complexe>` dans deploiements/<id>/.env.
# Ce fichier n'est qu'une DOCUMENTATION : le vrai .env est genere (secrets tires au
# hasard une fois puis conserves), il n'est jamais commite (deploiements/ est ignore).
#
# Trois familles : SECRETS (generes une fois, conserves), EXPLOITATION (reglables a la
# main dans le .env, conserves a chaque relance) et MARQUE (regenerees depuis le
# dossier du complexe a chaque relance : modifiez complexe.json, pas le .env).

# --- Complexe
COMPLEXE_IDENTIFIANT=exemple                       # identifiant du dossier (complexe.json)

# --- Images Docker : identiques pour tous les complexes
TERRAINAPP_VERSION=1.0.0                           # tag publie par la CI (v1.0.0 -> 1.0.0) ; --version pour changer
IMAGE_BACKEND=ghcr.io/malick2niang/backend_terrainapp
IMAGE_CLIENT=ghcr.io/malick2niang/client_terrainapp
IMAGE_MANAGER=ghcr.io/malick2niang/manager_terrainapp

# --- SECRETS (generes, jamais dans git, jamais par messagerie)
MYSQL_ROOT_PASSWORD=<48 caracteres hexadecimaux aleatoires>
MYSQL_DATABASE=terrainapp
MYSQL_USER=terrainapp
MYSQL_PASSWORD=<48 caracteres hexadecimaux aleatoires>
JWT_SECRET=<96 caracteres hexadecimaux aleatoires>  # signe les sessions du personnel ; le changer deconnecte tout le monde
# Empreintes BCrypt (base64 de { "identifiant": "$2a$..." }) des codes d'activation du
# personnel. Jamais les codes : ils ne sont affiches qu'une fois et ecrits dans
# CODES-ACTIVATION.txt (a remettre puis supprimer).
APP_COMPLEXE_ACTIVATIONS=<base64>
# Cles de paiement / SMS (quand les prestataires reels seront branches) : a ajouter ici,
# jamais dans clients/. Ex. PAYDUNYA_MASTER_KEY=, PAYDUNYA_PRIVATE_KEY=, PAYDUNYA_TOKEN=

# --- EXPLOITATION
SPRING_PROFILES_ACTIVE=prod                        # prod (defaut) ; --profil demo -> dev
SPRING_FLYWAY_LOCATIONS=classpath:db/migration     # jamais les donnees de demonstration
APP_PAIEMENT_PRESTATAIRE=simule                    # simule interdit en prod (en attendant PayDunya)
APP_SMS_PRESTATAIRE=simule                         # simule interdit en prod
APP_CORS_ALLOWED_ORIGINS=https://reserver.arena-exemple.sn,https://gestion.arena-exemple.sn
PORT_CLIENT=5180                                   # port publie de l'app des joueurs (derriere le proxy HTTPS)
PORT_MANAGER=5181                                  # port publie du back-office

# --- MARQUE (depuis complexe.json ; lues au demarrage des conteneurs)
MARQUE_NOM=Arena Exemple
MARQUE_NOM_ACCENT=Exemple
MARQUE_INITIALES=AE
MARQUE_LOGO_URL=/marque/logo.svg
MARQUE_SLOGAN=Votre terrain, réservé en une minute.
MARQUE_SOUS_TITRE=Réservation en ligne · Thiès
MARQUE_ETABLISSEMENT=Complexe sportif Arena Exemple
MARQUE_COULEUR=#0F766E
MARQUE_COULEUR_CLAIRE=#5EEAD4
MARQUE_ADRESSE=Route de Dakar, en face de la station, Thiès
MARQUE_VILLE=Thiès
MARQUE_TELEPHONE=+221 33 951 00 00
MARQUE_WHATSAPP=+221 77 000 00 00
MARQUE_EMAIL=contact@arena-exemple.sn
SUPPORT_TELEPHONE=+221 77 000 00 01
SUPPORT_EMAIL=support@arena-exemple.sn
URL_APP_CLIENT=https://reserver.arena-exemple.sn
APP_TICKET_MARGE_AVANT=30
