# Copier ce fichier en .env (jamais commite) et remplir les valeurs avant `docker compose up`
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=terrainapp
MYSQL_USER=terrainapp
MYSQL_PASSWORD=change_me
JWT_SECRET=change_me_generate_a_long_random_string
APP_AUTH_SEED_ENABLED=true
APP_AUTH_SEED_GERANT_PASSWORD=change_me_gerant_password
APP_AUTH_SEED_ACCUEIL_PASSWORD=change_me_accueil_password
APP_AUTH_SEED_CONTROLEUR_PASSWORD=change_me_controleur_password
APP_AUTH_SEED_ADMIN_PASSWORD=change_me_admin_password

# Profil Spring : dev (defaut : Swagger + terrains de demonstration) ou prod
# (Swagger coupe, verification de la configuration au demarrage).
SPRING_PROFILES_ACTIVE=dev

# Paiement : "simule" (PAIEMENT SIMULE, interdit en profil prod) en attendant
# PayDunya. Mode du simulateur : immediat (defaut) ou webhook.
APP_PAIEMENT_PRESTATAIRE=simule
APP_PAIEMENT_SIMULE_MODE=immediat
# Reservation non payee apres ce delai (minutes) : creneau libere.
APP_PAIEMENT_DELAI_EXPIRATION=15

# Marque blanche : identite du complexe installe (memes valeurs que les fronts).
MARQUE_NOM=Complexe Démo
MARQUE_SLOGAN=Réservez votre terrain en 1 minute
MARQUE_ADRESSE=Route de la Corniche
MARQUE_VILLE=Dakar
MARQUE_TELEPHONE=+221 33 000 00 00
MARQUE_WHATSAPP=+221 77 000 00 00
MARQUE_EMAIL=contact@exemple.sn

# Dossier du complexe (clients/<id>/), lu au demarrage : identite, regles,
# donnees initiales. Vide = marque MARQUE_* ci-dessus. Voir PERSONNALISER-UN-COMPLEXE.md.
# APP_COMPLEXE_DOSSIER=/app/complexe
# Empreintes BCrypt des codes d'activation du personnel (produites par npm run client).
# APP_COMPLEXE_ACTIVATIONS=
